# Copy to .env and fill in for local development.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=aldaftar
POSTGRES_USER=aldaftar
POSTGRES_PASSWORD=aldaftar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS: the Next.js dev origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- External feeds (integrations app) --------------------------------
# All optional: a missing key disables only that source. Everything else
# keeps syncing, and the site keeps serving the last good data.

# Weather. Default backend is OpenWeatherMap, whose free tier permits
# commercial use (60 calls/min). Sign up at openweathermap.org/api.
OPENWEATHER_API_KEY=

# ...or run keyless with Open-Meteo by setting this to `open-meteo`.
# ⚠️ Open-Meteo's free tier is NON-COMMERCIAL only — fine for local dev and
# staging, not for a live aldaftarnews.com. Never selected automatically.
WEATHER_PROVIDER=openweathermap

# News wire — NewsData.io (200 credits/day, production use allowed).
# NB: NewsAPI.org's free plan is development-only and bars commercial use.
NEWSDATA_API_KEY=

# Football — TheSportsDB. "3" is the free public key; covers the Egyptian
# Premier League, which football-data.org's free tier does not.
THESPORTSDB_KEY=3

# Currency (exchangerate.host) and prayer times (AlAdhan) need no key.
# Fallback USD/EGP used only before the first currency sync lands.
USD_EGP_FALLBACK=48.85
