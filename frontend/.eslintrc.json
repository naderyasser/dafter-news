{
  "extends": [
    "next/core-web-vitals"
  ],
  "ignorePatterns": [
    ".next/",
    ".next-new/",
    ".next-old/",
    ".next-dev/",
    ".next-verify/",
    "node_modules/",
    "scripts/*.js"
  ],
  "rules": {
    "@next/next/no-img-element": "warn",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-debugger": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "no-console": "off",
        "@next/next/no-img-element": "off"
      }
    }
  ]
}
